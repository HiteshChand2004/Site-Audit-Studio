# Copy to server/.env (gitignored). Every setting is optional: the server runs without a .env file.
# A missing .env does NOT shorten any timeout; the defaults below are built into the code.

# --- Who can reach the API, and what it may reach (server/src/config/index.js) ---------------------
# The address the API listens on. Default 127.0.0.1: this computer only. A hosted deployment sets it (0.0.0.0, or the container's
# address) and puts its own reverse proxy and login in front.
# SAS_BIND_HOST=127.0.0.1

# Which proxies in front of the API are believed about the visitor's address (X-Forwarded-For): the per-address limits on
# sign-up and sign-in use it. Default loopback = a proxy on this computer (Caddy, nginx). Otherwise a comma list of addresses /
# subnets (10.0.0.0/8) or loopback / linklocal / uniquelocal; off = believe nobody. "true" or a number is refused at start.
# SAS_TRUST_PROXY=loopback

# Allow the analyzer to reach loopback addresses (the local fixture sites on :4100). Never the API port. Off by default, and only
# in effect while SAS_BIND_HOST is a loopback address: set together with a network address, the server refuses to start.
# SAS_ALLOW_LOCALHOST=1

# User accounts (docs/ACCOUNTS.md). Off by default (0): the single-user tool, where everyone is the owner. 1 = sign-in, sessions,
# project ownership and the owner-only options (the owner account comes from SAS_OWNER_EMAIL at db:migrate). A deployed server
# (NODE_ENV=production) refuses to start with accounts off.
# SAS_ACCOUNTS=0

# Where throwaway job folders go. Default: the operating system's temp folder (server/src/config/paths.js has every path).
# SAS_TEMP_DIR=D:\sas-temp

# --- Time limits for a slow or busy machine -------------------------------------------------------
# Multiplies every Analyze step limit, page-load wait, the accessibility-scan limit, the time kept for
# Lighthouse and the total budget. 1–4, default 1. Use 1.5–2 when Analyze keeps timing out on a machine with
# little free memory (8 GB RAM with a browser, an editor and other apps open).
# SAS_TIMEOUT_SCALE=1.5

# Total time limit of one analysis in minutes (1–30). Default: 6 × SAS_TIMEOUT_SCALE.
# SAS_ANALYZE_MINUTES=9

# Total time limit of one Recreate in minutes (1–60, default 12).
# SAS_RECREATE_MINUTES=15

# Run the Recreate width sweep next to the page renders (1) or never (0). Unset = decided from free memory.
# SAS_RECREATE_OVERLAP=0

# Browser contexts (pages / widths / views) any step loads at once, a whole number 1–8. Unset = chosen from free memory
# (up to 4). 2 (or 1) keeps an 8 GB machine from running out of memory; it makes jobs slower, so give them more time too.
# SAS_MAX_PARALLEL=2

# Keep the computer awake while a job runs (a laptop that sleeps mid-job stalls it into timeouts). Default on; 0 turns it off.
# SAS_KEEP_AWAKE=1

# Shared cache of static files between a job's browser contexts (0 turns it off). Default on.
# SAS_SHARED_CACHE=1

# --- Ports and paths ------------------------------------------------------------------------------
# PORT=4000
# APP_ORIGIN=http://localhost:5173
# SAS_DATA_DIR=C:\path\to\data

# --- Jobs: how many, how long, how much memory (server/src/jobs/limits.js) -------------------------
# One job (a capture with four browser contexts, Lighthouse twice) uses several GB; two at once took a 15 GB machine down.
# Jobs that run at once on this server (1-8, default 1). The rest wait in line, first come first served, and are told their place.
# SAS_MAX_JOBS=1
# Jobs one account may have running or waiting at once (1-20, default 1). With accounts off there is one local user, so this is
# the whole queue's depth there; raise it to queue work on several sites.
# SAS_JOBS_PER_USER=1
# Hard time limit of one job in minutes (1-1440, default 240; 0 = none). Every pipeline has its own budget first (Analyze 6 min,
# Recreate 12 min grown with the page count, an as-is copy 20 min per page); this is the backstop for a job whose own budget did
# not end it. When it hits, the job is stopped like from the app, keeps what it finished, the row says why, and the next job starts.
# 240 covers every run recorded (longest 146 min) and an as-is copy of up to 11 pages at its 20-min-a-page budget; with one job at
# a time it is also the longest anyone waits behind one job. A larger site needs it raised (or a page limit on the website).
# SAS_JOB_MAX_MINUTES=240
# Free memory a job needs before it starts, in MB (default 2048; 0 = no check). Below it the job stays in line, says why, and is
# looked at again every few seconds. 2 GB is what the pipeline's own rules add up to for one job (150 MB per browser context x 4,
# 300 MB kept free, 900 MB more before a second browser opens) plus Lighthouse's own Chrome.
# SAS_JOB_MIN_FREE_MB=2048

# --- Disk cleanup (server/src/jobs/cleanup.js; "npm run cleanup -w server -- --dry-run" lists what a pass would do) --------
# Measured on real runs: a clean copy 16-235 MB, an as-is copy of one page ~130 MB, a workspace a crashed job left 10-118 MB,
# an analysis 1-3 MB. Scratch inside a copy and workspaces that cannot be continued go as soon as a job ends or the server starts.
# Days a finished copy is kept (0 = for ever by age; 1-3650, default 30). A website's newest finished copy is never removed by
# age, whatever its date: a person's latest copy is theirs until they make another or delete the website. 30 is longer than every
# window the app has (a stopped copy can be continued for 7 days, an analysis is called stale after 7), and one plan period.
# SAS_KEEP_COPIES_DAYS=30
# Hours between the server's own passes (0 = only at start-up and after a job; default 6).
# SAS_CLEANUP_HOURS=6
# 1 = the server's passes only log what they would remove; nothing is deleted. For the first days on a new host.
# SAS_CLEANUP_DRY_RUN=0

# --- Accounts and email (SAS_ACCOUNTS=1) ----------------------------------------------------------
# Where verification codes are emailed from (src/mail.js, nodemailer over SMTP). Port 465 = TLS from the first byte; any other
# port = STARTTLS, required (a server that cannot offer it is refused); a host on this computer (a local relay) = no TLS.
# Without SMTP_HOST a development server writes each email to its log instead; in production, accounts on without SMTP_HOST
# refuses to start. SMTP_USER and SMTP_PASS go together (a Gmail account needs an app password). SMTP_PASS is never logged.
# A code lasts 10 minutes and allows 5 tries; there is no resend — a new code means signing up again with the same address
# (at most 3 codes per address per hour, 6 per day).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=mailer@example.com
# SMTP_PASS=app-password
# MAIL_FROM=Remastly <mailer@example.com>
