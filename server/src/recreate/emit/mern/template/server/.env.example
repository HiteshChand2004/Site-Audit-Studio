# Copy to .env (or export these) before `npm start`. Nothing here is required: without MONGODB_URI the site is served and the forms answer 503.
PORT=3000
# Where form submissions are stored.
MONGODB_URI=mongodb://localhost:27017
FORMS_DB=site
FORMS_COLLECTION=submissions
# Development: keep submissions in memory instead of MongoDB (lost on restart).
# FORMS_STORE=memory
# Behind a reverse proxy, so the rate limit sees the real client address.
# TRUST_PROXY=true
# The built site (default ../client/dist).
# SITE_DIR=../client/dist
