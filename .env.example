# Public URL of the Remastly app (no trailing slash). The sign-in and sign-up forms post to
# $NEXT_PUBLIC_APP_URL/signin and $NEXT_PUBLIC_APP_URL/signup. Leave empty and the forms say sign-in is not open (nothing is sent).
NEXT_PUBLIC_APP_URL=

# Public URL of this marketing site, used for canonical URLs, the sitemap and link previews.
SITE_URL=https://remastly.com

# Public contact address. When set, the contact page shows it and the contact form opens the visitor's email app
# addressed to it. Leave empty and the form says it is not connected (nothing is sent).
NEXT_PUBLIC_CONTACT_EMAIL=
