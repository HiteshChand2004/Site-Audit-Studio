# Public URL of the Remastly app (no trailing slash). The sign-in and sign-up forms post to
# $NEXT_PUBLIC_APP_URL/signin and $NEXT_PUBLIC_APP_URL/signup. Leave empty to show "Sign-in opens soon".
NEXT_PUBLIC_APP_URL=

# Public URL of this marketing site, used for canonical URLs, the sitemap and link previews.
SITE_URL=https://remastly.com
